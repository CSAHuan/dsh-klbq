{
  "name": "dsh-klbq",
  "version": "0.1.0",
  "description": "卡拉彼丘（Strinova）战绩查询：按昵称从 dakanu.com 取数并渲染长图（排位段位/总览/模式/角色/最近对局），作为 DSH 工具 klbq_query 暴露给 agent",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./assets/icon.png",
  "author": "CSAHuan",
  "license": "MIT",
  "homepage": "https://github.com/CSAHuan/dsh-klbq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CSAHuan/dsh-klbq.git"
  },
  "bugs": {
    "url": "https://github.com/CSAHuan/dsh-klbq/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "klbq",
    "strinova",
    "dakanu",
    "game-stats"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
